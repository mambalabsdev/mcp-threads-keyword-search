{
  "name": "@mambalabsdev/mcp-threads-keyword-search",
  "version": "1.0.0",
  "description": "MCP server for Threads Keyword Search. Threads posts that contain your keywords, with author, date, likes, replies, and link, deduped across keywords. No login or key. Runs on Apify. Clay-ready output.",
  "type": "module",
  "bin": {
    "mcp-threads-keyword-search": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "threads",
    "threads-scraper",
    "social-listening",
    "keyword-search",
    "lead-generation",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/threads-keyword-search",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-threads-keyword-search"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-threads-keyword-search"
}
